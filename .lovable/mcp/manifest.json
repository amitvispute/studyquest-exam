{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gztffbygqnxhgaxhvlrk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "studyquest-mcp",
      "version": "0.1.0",
      "title": "StudyQuest MCP"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in user's id, display name, and role (parent or student).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_mock_exams",
        "title": "List mock exams",
        "description": "List AI-generated mock exams visible to the signed-in user (a student sees their own; a parent sees the ones they created).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Max exams to return"
            },
            "status": {
              "type": "string",
              "enum": [
                "scheduled",
                "in_progress",
                "completed"
              ],
              "description": "Optional status filter"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_logs",
        "title": "List recent study logs",
        "description": "Return the signed-in user's most recent daily study logs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 14,
              "description": "How many recent logs to return"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_study_session",
        "title": "Log a study session",
        "description": "Record a study session (subject, minutes, questions attempted, score) for the signed-in student. Date defaults to today.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "description": "Subject studied (e.g. Maths, VR, NVR, English)"
            },
            "minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600,
              "description": "Minutes spent studying"
            },
            "questions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 0,
              "description": "Questions attempted"
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 0,
              "description": "Questions answered correctly"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Optional date (YYYY-MM-DD); defaults to today"
            }
          },
          "required": [
            "subject",
            "minutes"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
